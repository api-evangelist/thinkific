              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "ID of the User in the form of an integer."
              },
              {
                "name": "group_id",
                "value": "",
                "type": "path",
                "description": "ID of the Group in the form of an integer."
              }
