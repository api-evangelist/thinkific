        },
        {
          "info": {
            "name": "Denies Product Publish Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.thinkific.com/api/public/v1/product_publish_requests/:id/deny",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the Product Publish Request in the form of an integer."
